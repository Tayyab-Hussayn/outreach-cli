# Dependencies
node_modules/
node_runtime/

# Python Virtual Environments, Bytecode & Cache
.venv/
venv/
ENV/
env/
workflows/scraper/venv/
**/__pycache__/
*.py[cod]
*$py.class

# Scraper Outputs & Run Dumps
output/
workflows/scraper/output/
reports/*.yaml
reports/*.json
!reports/.gitkeep

# Baileys WhatsApp Session / Credentials
workflows/whatsapp/auth_info/*
!workflows/whatsapp/auth_info/.gitignore

# Lead Lists with sensitive / real contact numbers
leads/whatsapp/numbers.yaml
leads/landline/
leads/*/archives/*
!leads/*/archives/.gitkeep

# Environment variables & secrets
.env
.env.*
!.env.example

# Operating system / IDE
.DS_Store
Thumbs.db
.idea/
.vscode/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Runtime error dumps, local scratch, real scraped email leads
error_logs/
.node/
leads/mail/emails.yaml
